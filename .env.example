# Copy this file to .env and adjust. Never commit .env.

# PostgreSQL connection used by the running app. It logs in as `yanmu_app`, a role that
# owns nothing and is bound by every row-level security policy (spec §13.1).
DATABASE_URL=postgres://yanmu_app:yanmu_app_dev@localhost:5432/yanmu

# Database owner, used only by migrations and seed scripts.
MIGRATION_DATABASE_URL=postgres://yanmu:yanmu@localhost:5432/yanmu

# Password given to `yanmu_app` by `pnpm db:migrate`. Must match DATABASE_URL.
APP_DB_PASSWORD=yanmu_app_dev

# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Optional: secret for the daily pickup QR codes. If empty, BETTER_AUTH_SECRET is used. Changing it changes every code of the day.
PICKUP_CODE_SECRET=

# Public URL of the app (what you type in the browser).
BETTER_AUTH_URL=http://localhost:3000

# Extra addresses allowed to sign in, comma separated. Add your computer's
# Wi-Fi address here to try the app from a phone, e.g. http://192.168.1.20:3000
TRUSTED_ORIGINS=

# Shows the "Demo data" pill on every screen. Never true in production.
DEMO_MODE=false

# Password given to the development test accounts by `pnpm seed:dev-users`.
# Development only: the seed script refuses to run when NODE_ENV=production.
DEV_USER_PASSWORD=Yanmu-dev-2026!
