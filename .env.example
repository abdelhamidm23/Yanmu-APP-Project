# Copy this file to .env and adjust. Never commit .env.

# PostgreSQL connection used by the app, migrations and seed scripts.
DATABASE_URL=postgres://yanmu:yanmu@localhost:5432/yanmu

# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app (what you type in the browser).
BETTER_AUTH_URL=http://localhost:3000

# Extra addresses allowed to sign in, comma separated. Add your computer's
# Wi-Fi address here to try the app from a phone, e.g. http://192.168.1.20:3000
TRUSTED_ORIGINS=

# Shows the "Demo data" pill on every screen. Never true in production.
DEMO_MODE=false

# Password given to the development test accounts by `pnpm seed:dev-users`.
# Development only: the seed script refuses to run when NODE_ENV=production.
DEV_USER_PASSWORD=Yanmu-dev-2026!
